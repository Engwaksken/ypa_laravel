APP_NAME="Youth Platform Africa"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Africa/Kampala
APP_URL=https://ypa.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kemmytec_ypa
DB_USERNAME=kemmytec_ypa
DB_PASSWORD=

# Comma-separated list of trusted reverse-proxy IPs (e.g. 10.0.0.1,10.0.0.2).
# Leave empty when the app is not behind a reverse proxy.
TRUSTED_PROXIES=
# Additional exact hostnames, comma-separated. APP_URL is always trusted.
TRUSTED_HOSTS=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_TABLE=sessions_laravel

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_HOST=mail.kemmytech.com
MAIL_PORT=465
MAIL_USERNAME=support@kemmytech.com
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_SCHEME=smtps
MAIL_TIMEOUT=15
MAIL_FROM_ADDRESS=support@kemmytech.com
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
